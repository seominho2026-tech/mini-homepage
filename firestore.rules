rules_version = '2';

/* Public entries are readable by everyone. New entries carry the Firebase
   anonymous owner's UID. Only that UID may delete; updates are denied.
   Legacy entries without ownerId remain readable and cannot be claimed.
   Each entry has bounded author/text/title, a server timestamp, and where
   applicable an HTTPS link and/or a compressed JPEG. */
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function validOwner(data) {
      return isAuthenticated() && data.ownerId is string
        && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid;
    }
    function isOwner() {
      return isAuthenticated() && resource.data.keys().hasAll(['ownerId'])
        && resource.data.ownerId == request.auth.uid;
    }
    match /guestbook/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['author', 'text', 'approved', 'createdAt', 'ownerId'])
        && validOwner(request.resource.data)
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 100
        && request.resource.data.approved == true
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isOwner();
    }

    /* 미니홈피 왼쪽 위 TODAY / TOTAL 방문 수입니다. 문서 하나만 씁니다.

       - 한 번에 total 을 1씩만 올릴 수 있습니다
       - 날짜(day)가 바뀐 첫 방문이면 today 는 1로 돌아갑니다
       - 필드는 total, today, day 세 개만 허용하고 삭제는 막습니다

       day 문자열이 진짜 오늘인지는 규칙에서 확인하지 못합니다.
       조작하더라도 today 가 1로 리셋되는 정도이고 total 은 영향받지 않습니다. */

    // Public posts: author/title/text plus a link or a compressed JPEG.
    // Authors may delete their own entries. Updating or claiming entries is denied.
    function validPostBase(data) {
      return validOwner(data) && data.author is string && data.author.size() >= 1 && data.author.size() <= 20
        && data.author.matches('.*[^ ].*')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.title.matches('.*[^ ].*')
        && data.text is string && data.text.size() <= 3000
        && data.createdAt == request.time;
    }
    function validBoardPost(data) {
      return data.keys().hasAll(['author', 'title', 'text', 'href', 'createdAt', 'ownerId'])
        && data.keys().hasOnly(['author', 'title', 'text', 'href', 'createdAt', 'ownerId'])
        && validPostBase(data) && data.text.size() >= 1
        && data.href is string && data.href.size() <= 2048
        && (data.href == '' || data.href.matches('https://[^/ ?#@]+[.][^/ ?#@]+.*'));
    }
    function validPhotoPost(data) {
      return data.keys().hasAll(['author', 'title', 'text', 'imageData', 'createdAt', 'ownerId'])
        && data.keys().hasOnly(['author', 'title', 'text', 'imageData', 'createdAt', 'ownerId'])
        && validPostBase(data)
        && data.imageData is string && data.imageData.size() <= 450000
        && data.imageData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }
    function validLabPost(data) {
      return data.keys().hasAll(['author', 'title', 'text', 'href', 'imageData', 'createdAt', 'ownerId'])
        && data.keys().hasOnly(['author', 'title', 'text', 'href', 'imageData', 'createdAt', 'ownerId'])
        && validPostBase(data) && data.text.size() >= 1
        && data.href is string && data.href.size() <= 2048
        && (data.href == '' || data.href.matches('https://[^/ ?#@]+[.][^/ ?#@]+.*'))
        && data.imageData is string && data.imageData.size() <= 450000
        && data.imageData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }
    function validSavedLink(data, video) {
      let fields = video
        ? ['author', 'title', 'text', 'href', 'imageData', 'createdAt', 'ownerId']
        : ['author', 'title', 'text', 'href', 'createdAt', 'ownerId'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && validPostBase(data) && data.text == ''
        && data.href is string && data.href.size() <= 2048
        && data.href.matches('https://[^/ ?#@]+[.][^/ ?#@]+.*')
        && (!video || (data.imageData is string && data.imageData.size() <= 450000
          && data.imageData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
    }
    match /bookmarkEntries/{postId} {
      allow read: if true;
      allow create: if validSavedLink(request.resource.data, false);
      allow update: if false;
      allow delete: if isOwner();
    }
    match /videoEntries/{postId} {
      allow read: if true;
      allow create: if validSavedLink(request.resource.data, true);
      allow update: if false;
      allow delete: if isOwner();
    }
    match /labEntries/{postId} {
      allow read: if true;
      allow create: if validLabPost(request.resource.data);
      allow update: if false;
      allow delete: if isOwner();
    }
    match /boardEntries/{postId} {
      allow read: if true;
      allow create: if validBoardPost(request.resource.data);
      allow update: if false;
      allow delete: if isOwner();
    }
    match /photoEntries/{postId} {
      allow read: if true;
      allow create: if validPhotoPost(request.resource.data);
      allow update: if false;
      allow delete: if isOwner();
    }

    match /counters/site {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['total', 'today', 'day'])
        && request.resource.data.total == 1
        && request.resource.data.today == 1
        && request.resource.data.day is string;

      allow update: if request.resource.data.keys().hasOnly(['total', 'today', 'day'])
        && request.resource.data.total is int
        && request.resource.data.today is int
        && request.resource.data.day is string
        && request.resource.data.total == resource.data.total + 1
        && (
          (request.resource.data.day == resource.data.day
            && request.resource.data.today == resource.data.today + 1)
          || (request.resource.data.day != resource.data.day
            && request.resource.data.today == 1)
        );

      allow delete: if false;
    }

    /* 그 밖의 모든 경로는 차단합니다. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
